# Server Configuration
PORT=3000
NODE_ENV=production

# API Keys (Store these securely - never expose to client)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_change_in_production
JWT_EXPIRY=24h
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Admin Credentials (Use bcrypt hash, never plaintext)
ADMIN_EMAIL=admin@waybound.app
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_hash_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
MAX_LOGIN_ATTEMPTS=4
LOCKOUT_DURATION_MS=1800000