# PostHog
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# API Keys (Move these to a secure backend - never commit actual keys)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Backend Proxy Server (local dev)
BACKEND_API_URL=http://localhost:3000/api

# Public backend origin used by the app in production builds (inlined at build
# time by Expo — must be set before running `eas build`). Example:
# EXPO_PUBLIC_API_URL=https://waybound-backend.onrender.com
# EXPO_PUBLIC_API_URL=

# HTTPS redirect URI for the Google OAuth browser fallback — points at the
# deployed backend's /oauth2redirect endpoint. Register the same URL as an
# authorized redirect URI on the Web OAuth client in Google Cloud.
# EXPO_PUBLIC_OAUTH_REDIRECT_URL=https://waybound-backend.onrender.com/oauth2redirect
# EXPO_PUBLIC_OAUTH_REDIRECT_URL=

# Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_32_chars

# Admin Credentials (Store securely in backend, not here)
ADMIN_EMAIL=admin@waybound.app
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_hash_here